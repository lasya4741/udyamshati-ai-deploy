# Frontend Configuration (Vite requires VITE_ prefix for client-exposed variables)

# Google Maps JavaScript API Key (Optional - falls back to OpenStreetMap / Leaflet)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Client ID (Optional - for Google Login)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
