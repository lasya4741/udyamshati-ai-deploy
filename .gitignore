# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Python virtual environment & cache
venv/
env/
ai-service/venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Build artifacts
dist/
build/
frontend/dist/

# Environment variables & secrets (recursively ignore all real .env files, allow .env.example)
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# Sensitive credentials, certificates, & private keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
id_rsa*

# Backup JSON dumps & temporary files
backend/src/scripts/*.json
*.dump
*.bak
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

