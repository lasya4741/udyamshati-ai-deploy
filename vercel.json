{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    },
    "api/ai.py": {
      "includeFiles": "data/**,ai-service/**"
    }
  },
  "rewrites": [
    {
      "source": "/ai/:path*",
      "destination": "/api/ai"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
