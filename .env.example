# ==============================================================================
# UdyamSetu AI — Master Environment Configuration Example
# ==============================================================================
# You can copy individual examples to:
#   - ai-service/.env
#   - backend/.env
#   - frontend/.env
#
# All variables below have built-in zero-config fallbacks for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Analytics Microservice (ai-service/.env)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Optional — fallback is deterministic rule-based multilingual NLU)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Models: gemini-1.5-flash (default), gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Backend Orchestrator (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
AI_SERVICE_URL=http://127.0.0.1:8001

# Supabase PostgreSQL Database (Pooling or Direct)
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Maps Platform Server Key (Optional — fallback is local data/places_catalog.json)
GOOGLE_MAPS_SERVER_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 3. Frontend Client (frontend/.env)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API Key (Optional — fallback is OpenStreetMap / Leaflet)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Web Client ID (Optional — for Google Sign-In)
# Format: <client-id>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
